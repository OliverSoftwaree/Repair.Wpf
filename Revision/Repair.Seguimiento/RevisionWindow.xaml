<Window x:Class="Repair.Seguimiento.RevisionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Repair · Revisión local" Width="690" Height="450" MinWidth="490" MinHeight="380"
        WindowStartupLocation="CenterScreen" Background="#EFF3F7" Foreground="#15283D"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Foreground" Value="#164D46" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C9D8E5" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,22,26,22">
            <Border CornerRadius="12" Background="#15283D" Padding="20,16" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Repair" FontSize="29" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Revisión local · Base de pruebas" Foreground="#BEE8DE" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Button Content="_Seguimiento y entrega · consulta" Click="AbrirSeguimiento" />
            <Button Content="_Diagnóstico · versión de Oliver" Click="AbrirDiagnostico" />
            <Button Content="_Clientes y equipos · Tipo y CSV" Click="AbrirClientesEquipos" />
            <TextBlock x:Name="Aviso" Foreground="#853B32" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Window>
