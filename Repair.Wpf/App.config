<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" /></startup>
  <!-- Esta copia de integración inicia en demostración. Para verificar con SQL, usa la base de pruebas. -->
  <appSettings><add key="Modo" value="Demostracion" /></appSettings>
  <connectionStrings>
    <add name="RepairSql" providerName="System.Data.SqlClient" connectionString="Data Source=.;Initial Catalog=RepairSeguimientoDesarrollo_20261115;Integrated Security=True;Connect Timeout=5;Application Name=Repair.Wpf" />
  </connectionStrings>
</configuration>
