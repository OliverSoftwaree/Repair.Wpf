<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" /></startup>
  <!-- La aplicación siempre inicia en SQL salvo el argumento demo o este ajuste explícito. -->
  <appSettings><add key="Modo" value="Sql" /></appSettings>
  <connectionStrings>
    <add name="RepairSql" providerName="System.Data.SqlClient" connectionString="Data Source=.;Initial Catalog=RepairAcademico;Integrated Security=True;Connect Timeout=5;Application Name=Repair.Wpf" />
  </connectionStrings>
</configuration>
