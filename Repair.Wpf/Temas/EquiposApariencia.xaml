<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Solo pintura y plantillas visuales, limitadas a las dos vistas de Equipos.
       No establece tamaños, márgenes, fuentes ni distribución de sus controles. -->
  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground" Value="#536974" />
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="#CBD8DF" />
    <Setter Property="Foreground" Value="#20333D" />
  </Style>

  <ControlTemplate x:Key="EquipoBotonVisual" TargetType="Button">
    <Grid>
      <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
        <!-- Mantiene la medida original del contenido; el rótulo se pinta sin partir palabras. -->
        <ContentPresenter Opacity="0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
      </Border>
      <TextBlock Text="{TemplateBinding Content}" TextWrapping="NoWrap" Foreground="{TemplateBinding Foreground}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65" /></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#B95C20" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="EquipoGuardar" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Template" Value="{StaticResource EquipoBotonVisual}" />
    <Setter Property="Background" Value="#ED8B48" />
    <Setter Property="BorderBrush" Value="#D87938" />
    <Setter Property="Foreground" Value="#302319" />
  </Style>
  <Style x:Key="EquipoSecundario" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Template" Value="{StaticResource EquipoBotonVisual}" />
    <Setter Property="Background" Value="#253B45" />
    <Setter Property="BorderBrush" Value="#253B45" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style x:Key="EquipoEliminar" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Template" Value="{StaticResource EquipoBotonVisual}" />
    <Setter Property="Background" Value="#FFF6F4" />
    <Setter Property="BorderBrush" Value="#E7C7BF" />
    <Setter Property="Foreground" Value="#A04C3E" />
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="#CBD8DF" />
    <Setter Property="Foreground" Value="#20333D" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /></Grid.ColumnDefinitions>
            <ToggleButton x:Name="SelectorSurface" Grid.ColumnSpan="2" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                          Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                    <Path Data="M 0,0 L 3.5,3.5 7,0" Stroke="#B9652E" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="8" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                  </Border>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"
                              IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
            <TextBlock x:Name="SelectorPrompt" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                       Text="{TemplateBinding Tag}" TextWrapping="NoWrap" Foreground="#7B8E99" IsHitTestVisible="False" Visibility="Collapsed" />
            <Popup x:Name="PART_Popup" Grid.ColumnSpan="2" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
              <Border Background="White" BorderBrush="#C8D5DC" BorderThickness="1" CornerRadius="5"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="SelectedIndex" Value="-1"><Setter TargetName="SelectorPrompt" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="SelectorSurface" Property="Background" Value="#FFF8F1" />
              <Setter TargetName="SelectorSurface" Property="BorderBrush" Value="#D8A078" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="SelectorSurface" Property="BorderBrush" Value="#C46D31" />
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Setter TargetName="SelectorSurface" Property="Background" Value="#FFF4E9" />
              <Setter TargetName="SelectorSurface" Property="BorderBrush" Value="#C46D31" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="SelectorSurface" Property="Background" Value="#EDF1F3" />
              <Setter TargetName="SelectorSurface" Property="BorderBrush" Value="#DCE4E8" />
              <Setter Property="Foreground" Value="#8899A2" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Background" Value="White" />
    <Setter Property="Foreground" Value="#20333D" />
    <Style.Triggers>
      <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#FFF0E2" /></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FCE1CA" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="ListView">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="#CBD8DF" />
    <Setter Property="Foreground" Value="#263E49" />
  </Style>
  <Style TargetType="GridViewColumnHeader">
    <Setter Property="Background" Value="#EAF0F3" />
    <Setter Property="BorderBrush" Value="#D5E0E6" />
    <Setter Property="Foreground" Value="#4C6572" />
  </Style>
  <Style TargetType="ListViewItem">
    <Setter Property="Foreground" Value="#263E49" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F3F7F8" /></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FFF0E2" /><Setter Property="BorderBrush" Value="#E7B58C" /></Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
