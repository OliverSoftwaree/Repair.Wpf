<UserControl x:Class="Repair.Wpf.Presentacion.ReportesControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Reportes del taller" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Órdenes y entregas por estado y fecha" Style="{StaticResource MutedText}" Margin="0,8,0,15"/></StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,14">
   <StackPanel Margin="0,0,12,8"><TextBlock Text="Estado"/><ComboBox x:Name="Estado" Width="155" SelectedIndex="0"><ComboBoxItem Content="Todos"/><ComboBoxItem Content="Pendiente"/><ComboBoxItem Content="En diagnóstico"/><ComboBoxItem Content="En reparación"/><ComboBoxItem Content="Lista para entrega"/><ComboBoxItem Content="Entregada"/></ComboBox></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="Desde"/><DatePicker x:Name="Desde" Width="130"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="Hasta"/><DatePicker x:Name="Hasta" Width="130"/></StackPanel>
   <CheckBox x:Name="SoloEntregas" Content="Solo entregas" VerticalAlignment="Center" Margin="0,0,12,0"/>
   <Button x:Name="Consultar" Content="Consultar" Click="Consultar_Click" Margin="0,0,8,8"/>
   <Button x:Name="Exportar" Content="Exportar CSV" Click="Exportar_Click" IsEnabled="False" Margin="0,0,8,8"/>
   <Button x:Name="Imprimir" Content="Imprimir" Click="Imprimir_Click" IsEnabled="False" Margin="0,0,0,8"/>
  </WrapPanel>
  <DataGrid x:Name="Tabla" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False" HorizontalScrollBarVisibility="Auto"/>
  <TextBlock x:Name="Mensaje" Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap"/>
 </Grid>
</UserControl>
