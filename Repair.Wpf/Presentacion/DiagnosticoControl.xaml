<UserControl x:Class="Repair.Wpf.Presentacion.DiagnosticoControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    mc:Ignorable="d" d:DesignHeight="500" d:DesignWidth="760">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Diagnóstico técnico" FontSize="18" FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Cliente:" Width="70" VerticalAlignment="Center" />
                    <ComboBox x:Name="ClienteSelector" Width="220" SelectionChanged="ClienteSelector_SelectionChanged" />
                    <TextBlock Text="Orden:" Width="60" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <ComboBox x:Name="OrdenSelector" Width="140" SelectionChanged="OrdenSelector_SelectionChanged" />
                    <TextBlock Text="ID:" Width="30" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <TextBox x:Name="OrdenInput" Width="110" />
                    <Button x:Name="BuscarOrdenButton" Width="110" Margin="10,0,0,0" Content="Buscar" Click="BuscarOrdenButton_Click" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" BorderBrush="#E1E6E8" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="OrdenInfoText" Text="Busca una orden por ID para comenzar el diagnóstico." Foreground="#5B6E76" />
                    <TextBlock x:Name="ClienteInfoText" Text="Cliente: --" Margin="0,6,0,0" Foreground="#425862" FontWeight="SemiBold" />
                    <TextBlock x:Name="EquipoInfoText" Text="Equipo: --" Margin="0,6,0,0" Foreground="#425862" TextWrapping="Wrap" />
                    <TextBlock x:Name="EstadoText" Text="Estado: --" Margin="0,8,0,0" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" >
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Severidad" Margin="0,0,0,4" FontWeight="SemiBold" />
                        <ComboBox x:Name="SeveridadCombo" SelectedIndex="1" SelectionChanged="DiagnosticoPreview_Changed">
                            <ComboBoxItem Content="Leve" />
                            <ComboBoxItem Content="Media" />
                            <ComboBoxItem Content="Grave" />
                            <ComboBoxItem Content="Crítica" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Acción recomendada" Margin="0,0,0,4" FontWeight="SemiBold" />
                        <ComboBox x:Name="AccionCombo" SelectedIndex="0" SelectionChanged="DiagnosticoPreview_Changed">
                            <ComboBoxItem Content="Revisar" />
                            <ComboBoxItem Content="Cambiar pieza" />
                            <ComboBoxItem Content="Enviar a fábrica" />
                            <ComboBoxItem Content="No reparable" />
                            <ComboBoxItem Content="Reparado" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Diagnóstico técnico" Margin="0,6,0,4" FontWeight="SemiBold" />
                <TextBox x:Name="DiagnosticoInput" Height="82" TextWrapping="Wrap" AcceptsReturn="True" TextChanged="DiagnosticoPreview_Changed" VerticalScrollBarVisibility="Auto" />
                <Border BorderBrush="#E1E6E8" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,6,0,0">
                    <TextBlock x:Name="DiagnosticoPreviewText" TextWrapping="Wrap" Foreground="#5B6E76" MaxHeight="38" />
                </Border>

                <TextBlock Text="Hallazgos del ingreso / piezas / observaciones" Margin="0,8,0,4" FontWeight="SemiBold" />
                <TextBox x:Name="ObservacionesInput" Height="62" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
            </StackPanel>
            </Grid>
        </ScrollViewer>
        <Border Grid.Row="1" Background="#F5F7F8" BorderBrush="#E1E6E8" BorderThickness="0,1,0,0" Padding="8,6" Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MensajeText" VerticalAlignment="Center" Foreground="Red" TextWrapping="Wrap" MaxHeight="38" Visibility="Collapsed" />
                <Button x:Name="GuardarDiagnosticoButton" Grid.Column="1" Width="180" Height="34" Content="Guardar diagnóstico" Click="GuardarDiagnosticoButton_Click" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
