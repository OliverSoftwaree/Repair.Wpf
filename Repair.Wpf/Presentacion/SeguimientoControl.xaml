<UserControl x:Class="Repair.Wpf.Presentacion.SeguimientoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
    <StackPanel MaxWidth="850" HorizontalAlignment="Stretch">
      <TextBlock Text="Seguimiento y entrega" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="Consulta la orden y continúa el trabajo según tu rol." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,20" />
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <Label Content="_Número de orden" Target="{Binding ElementName=NumeroOrden}" FontWeight="SemiBold" Padding="0,0,0,7" />
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="NumeroOrden" MaxLength="10" PreviewKeyDown="NumeroOrden_KeyDown" AutomationProperties.Name="Número de orden" />
            <Button x:Name="BuscarOrden" Content="Buscar orden" Click="BuscarOrden_Click" IsEnabled="False" Grid.Column="1"
                    Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" AutomationProperties.AutomationId="BuscarOrdenSeguimiento" />
          </Grid>
          <TextBlock x:Name="MensajeConsulta" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,12,0,0"
                     AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </Border>
      <Border x:Name="ResultadoOrden" Style="{StaticResource Card}" Visibility="Collapsed">
        <StackPanel>
          <DockPanel Margin="0,0,0,18">
            <Border DockPanel.Dock="Right" Background="#E5F1EA" CornerRadius="8" Padding="11,5" VerticalAlignment="Center" Margin="12,0,0,0">
              <TextBlock x:Name="EstadoOrden" Foreground="#315B48" FontWeight="SemiBold" />
            </Border>
            <TextBlock x:Name="TituloOrden" FontSize="22" FontWeight="SemiBold" />
          </DockPanel>
          <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Cliente" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,4" />
              <TextBlock x:Name="ClienteOrden" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Equipo" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,4" />
              <TextBlock x:Name="EquipoOrden" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
          <Border CornerRadius="9" Background="#F1F5F6" Padding="14,12">
            <StackPanel>
              <TextBlock Text="Diagnóstico" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,4" />
              <TextBlock x:Name="DiagnosticoOrden" TextWrapping="Wrap" />
              <StackPanel x:Name="BloqueObservaciones" Margin="0,12,0,0">
                <TextBlock Text="Observaciones" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock x:Name="ObservacionesOrden" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock x:Name="FechaEntrega" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,15,0,0" FontWeight="SemiBold" />
          <WrapPanel Margin="0,16,0,0">
            <Button x:Name="Avanzar" Visibility="Collapsed" Click="Avanzar_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
            <Button x:Name="Reingresar" Visibility="Collapsed" Content="Registrar nuevo ingreso" Click="Reingresar_Click"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
